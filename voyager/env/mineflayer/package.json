{
    "name": "voyager",
    "version": "2.0.0",
    "description": "Mineflayer bridge between the Voyager Python agent and a Minecraft server",
    "main": "index.js",
    "private": true,
    "scripts": {
        "build": "tsc -p mineflayer-collectblock",
        "postinstall": "npm run build",
        "test": "node test/smoke-test.js",
        "setup:26.3": "node mc-26.3/setup.js"
    },
    "license": "MIT",
    "engines": {
        "node": ">=20.10"
    },
    "dependencies": {
        "express": "^5.2.1",
        "minecraft-data": "3.117.0",
        "minecrafthawkeye": "^1.3.9",
        "mineflayer": "4.39.0",
        "mineflayer-collectblock": "file:mineflayer-collectblock",
        "mineflayer-pathfinder": "^2.4.5",
        "mineflayer-pvp": "^1.3.2",
        "mineflayer-tool": "^1.2.0",
        "typescript": "^5.9.3",
        "vec3": "^0.1.10"
    },
    "overrides": {
        "minecraft-data": "$minecraft-data",
        "mineflayer": "$mineflayer",
        "minecraft-protocol": "1.68.0",
        "prismarine-chunk": "1.41.0",
        "prismarine-physics": "1.11.1"
    },
    "devDependencies": {
        "prettier": "2.8.5"
    }
}
